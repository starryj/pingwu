<?xml version="1.0" encoding="utf-8"?>
<!-- 健康数据不参与云备份与设备迁移（Android 12+ 的 dataExtractionRules） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>